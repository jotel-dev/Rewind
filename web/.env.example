# Only needed if you add a WalletConnect-based wallet to src/wagmi.ts.
# QoreX and injected browser wallets do not use it.
VITE_WALLETCONNECT_PROJECT_ID=

# Public Rewind settings (never put signing credentials in VITE_ variables)
VITE_REWIND_ADDRESS=0x775BbF36986FaBC54b64955c1D9b8EdB388E7c20
VITE_RPC_URL=https://evm-testnet.qore.host

# Public Rewind deployment block from the chain-9800 Ignition receipt.
# Set to unknown only when the deployment block is unavailable (600,000-block fallback).
VITE_REWIND_DEPLOY_BLOCK=10320988
